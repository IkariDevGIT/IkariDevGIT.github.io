---
import type { GetStaticPaths } from 'astro';
import { getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import BlogSortLinks from '../../../components/BlogSortLinks.astro';
import Pagination from '../../../components/Pagination.astro';
import { getAllPostMeta, sortByLatestUpdate, sortByNewest, sortByOldest, type SortMode } from '../../../lib/posts';
import { BLOG_PAGE_SIZE } from '../../../consts';

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getAllPostMeta();

  const groups: { sort: SortMode; posts: Awaited<ReturnType<typeof getAllPostMeta>> }[] = [
    { sort: 'newest', posts: sortByNewest(allPosts) },
    { sort: 'oldest', posts: sortByOldest(allPosts) },
    { sort: 'latest-update', posts: sortByLatestUpdate(allPosts) },
  ];

  return groups.flatMap(({ sort, posts }) =>
    paginate(posts, { params: { sort }, pageSize: BLOG_PAGE_SIZE }),
  );
}) satisfies GetStaticPaths;

const blogPage = await getEntry('pages', 'blog');
if (!blogPage) throw new Error('Missing src/content/pages/blog.md');

const { sort } = Astro.params as { sort: SortMode };
const { page } = Astro.props;

const redirectParams = [];
if (sort !== 'newest') redirectParams.push(`sort=${sort}`);
if (page.currentPage !== 1) redirectParams.push(`page=${page.currentPage}`);
const redirectTarget = `/blog/${redirectParams.length ? `?${redirectParams.join('&')}` : ''}`;
---

<BaseLayout title={blogPage.data.title} description={blogPage.data.description} noindex>
  <Fragment slot="head">
    <script is:inline set:html={`location.replace(${JSON.stringify(redirectTarget)});`} />
  </Fragment>

  <h1>Blog</h1>

  <picture>
    <source srcset="/images/badges/typos.webp" type="image/webp" />
    <img src="/images/badges/typos.gif" alt="Typos... who needs backspase!" width="150" height="20" loading="lazy" />
  </picture>
  <p class="notice panel">
    This page has no JavaScript, so no search and no tag filtering. For that, use the <a href="/blog/">regular blog page</a>.
  </p>

  <div class="blog-controls">
    <div class="post-search">
      <label for="post-search-input">Search posts by title</label>
      <input type="text" id="post-search-input" autocomplete="off" placeholder="Search by title" disabled />
    </div>
    <BlogSortLinks sort={sort} />
  </div>

  <details class="tag-filter tag-filter-disabled">
    <summary tabindex="-1" aria-disabled="true">Filter by tags</summary>
  </details>

  <hr />

  <ol class="post-list">
    {page.data.map((post) => <PostCard post={post} />)}
  </ol>
  <Pagination page={page} />
</BaseLayout>
