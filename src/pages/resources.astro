---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResourceSection from '../components/ResourceSection.astro';
import ResourceToc from '../components/ResourceToc.astro';

const entry = await getEntry('resources', 'main');
if (!entry) throw new Error('Missing "main" entry in src/content/resources.yaml');
const { intro, sections } = entry.data;
---

<BaseLayout
  title="Resources"
  description={intro}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Resources', url: '/resources/' },
  ]}
>
  <h1>Resources</h1>
  <p>{intro}</p>

  <h2>Overview</h2>
  <ResourceToc groups={sections} />

  <hr />

  <div class="panel">
    {sections.map((section) => <ResourceSection group={section} level={2} />)}
  </div>
</BaseLayout>
