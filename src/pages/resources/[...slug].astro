---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceSection from '../../components/ResourceSection.astro';
import ResourceToc from '../../components/ResourceToc.astro';
import { resourceListUrl } from '../../lib/resourcesText';
import { resolveResourceList } from '../../lib/resources';
import { REPO_URL } from '../../lib/buildInfo.mjs';

export const getStaticPaths = (async () => {
  const lists = await getCollection('resources');
  return lists.map((list) => ({
    params: { slug: list.id === 'main' ? undefined : list.id },
    props: { list },
  }));
}) satisfies GetStaticPaths;

const { list } = Astro.props;

const page = await getEntry('pages', `resources/${list.id}`);
if (!page) throw new Error(`Missing src/content/pages/resources/${list.id}.md`);
const { Content } = await render(page);
const sections = resolveResourceList(list);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Resources', url: '/resources/' },
];
if (list.id !== 'main') breadcrumbs.push({ name: page.data.title, url: resourceListUrl(list.id) });
---

<BaseLayout title={page.data.title} description={page.data.description} breadcrumbs={breadcrumbs} hideSidebar>
  <h1>{page.data.title}</h1>
  <p>{page.data.description}</p>
  {
    list.id === 'main' && (
      <p>
        Want something added? Hit me up through my <a href="/about/#contact">contact stuff</a> or{' '}
        <a href={`${REPO_URL}/issues/new?template=add-resource.yml`} target="_blank" rel="noopener">open an issue</a>.
      </p>
    )
  }

  <h2>Overview</h2>
  <ResourceToc groups={sections} />

  <hr />

  <div class="panel resource-list">
    {sections.map((section) => <ResourceSection group={section} level={2} />)}
  </div>

  <Content />
</BaseLayout>
