---
import { getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { personJsonLd } from '../lib/personJsonLd';
import avatar from '../assets/avatar.png';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing src/content/pages/about.md');
const { Content } = await render(page);

const avatarImage = await getImage({ src: avatar, width: 500 });

const profileJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${Astro.site}#profile`,
  url: new URL('/about/', Astro.site).toString(),
  mainEntity: personJsonLd(Astro.site, page.data.description, avatarImage.src),
};
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: page.data.title, url: '/about/' },
  ]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(profileJsonLd)} />
  </Fragment>

  <h1>{page.data.title}</h1>
  <Content />
</BaseLayout>
