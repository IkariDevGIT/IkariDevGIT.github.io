---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { ogImagePath } from '../../lib/ogImage';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import { resolvePostDates } from '../../lib/postDates';
import { isRepostPost, withLegacyTag } from '../../lib/posts';
import { formatPostDate } from '../../lib/dateFormat.mjs';
import { SITE_TITLE } from '../../consts';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);

const { pubDate, updatedDate } = resolvePostDates(entry.data, remarkPluginFrontmatter);
const wordCount = remarkPluginFrontmatter.wordCount ?? 0;
const minutesRead = remarkPluginFrontmatter.minutesRead ?? 1;


const tags = withLegacyTag(entry);
const isLegacy = tags.includes('legacy');
const isNsfw = tags.includes('nsfw');
const isUnlisted = entry.data.unlisted;
const isRepost = isRepostPost(entry);
const repostTarget = entry.data.repost;


const blogPostingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: SITE_TITLE,
    url: new URL('/about/', Astro.site).toString(),
  },
  image: [new URL(ogImagePath(Astro.url.pathname), Astro.site).toString()],
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
  wordCount,
  keywords: tags.join(', '),
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  article={{
    publishedTime: pubDate.toISOString(),
    modifiedTime: updatedDate?.toISOString(),
  }}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog/' },
    { name: entry.data.title, url: `/blog/${entry.id}/` },
  ]}
  noindex={isNsfw || isUnlisted || isRepost}
  hideSidebar
>
  <Fragment slot="head">
    {isRepost ? (
      <noscript>
        <meta http-equiv="refresh" content={`0; url=${repostTarget}`} />
      </noscript>
    ) : (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(blogPostingJsonLd)} />
    )}
  </Fragment>
  {isRepost && repostTarget && (
    <div class="repost-redirect">
      <article class="panel repost-card">
        <h1>
          <span class="repost-mark" aria-hidden="true">⟳</span>
          Taking you to <a href={repostTarget}>{new URL(repostTarget).hostname}</a>.
        </h1>
      </article>
      <script is:inline define:vars={{ repostTarget }}>
        addEventListener('load', () => location.replace(repostTarget));
      </script>
    </div>
  )}
  {!isRepost && isLegacy && (
    <p class="notice panel">
      This post wont be updated as of 15 September 2026. Its mostly outdated and was only
      migrated to the new site to keep the history around. If you wanna read more, check out
      the <a href="/blog/site-rebuild-2026/">site rebuild post</a>.
    </p>
  )}
  {!isRepost && (
  <article class:list={['panel', 'post-panel', { 'legacy-card': isLegacy }]}>
    <h1>{entry.data.title}</h1>
    <p class="meta-line">
      Published <time datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
      {updatedDate && (
        <>
          {' · Updated '}
          <time datetime={updatedDate.toISOString()}>{formatPostDate(updatedDate)}</time>
        </>
      )}
    </p>
    <p class="meta-line">{wordCount} words · {minutesRead} min read</p>
    {tags.length > 0 && (
      <ul class="tag-list">
        {tags.map((tag) => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
    )}
    {entry.data.cover && (
      <figure class="post-cover">
        <Image src={entry.data.cover} alt={entry.data.coverAlt ?? ''} width={1200} loading="lazy" />
      </figure>
    )}
    {isNsfw && (
      <div class="nsfw-gate panel" id="nsfw-gate">
        <p><strong>This post is age-restricted (18+).</strong></p>
        <noscript>
          <p>Viewing this needs JavaScript enabled.</p>
        </noscript>
        <div id="nsfw-gate-prompt" hidden>
          <p>Are you 18 or older?</p>
          <button type="button" class="btn" id="nsfw-yes">Yes, im 18+</button>
          <button type="button" class="btn" id="nsfw-no">No</button>
        </div>
      </div>
    )}
    <div class="post-content" id="post-content" hidden={isNsfw}>
      <Content />
    </div>
  </article>
  )}
  {!isRepost && !isNsfw && <Comments />}
  {isNsfw && <script is:inline type="module" src="/scripts/nsfw-gate.js"></script>}
</BaseLayout>
