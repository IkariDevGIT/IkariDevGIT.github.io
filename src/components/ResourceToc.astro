---
import type { ResolvedGroup } from '../lib/resources';

interface Props {
  groups: ResolvedGroup[];
}

const { groups } = Astro.props;
---

<ul>
  {
    groups.map((group) => (
      <li>
        <a href={`#${group.id}`}>{group.title}</a>
        {group.groups && group.groups.length > 0 && <Astro.self groups={group.groups} />}
      </li>
    ))
  }
</ul>
