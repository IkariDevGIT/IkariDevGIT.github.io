---
import { getPostHistory, getHeadCommit, OLD_SITE_TREE_URL } from '../lib/postHistory.mjs';
import { formatPostDate } from '../lib/dateFormat.mjs';

interface Props {
  slug: string;
  isLegacy: boolean;
}

const { slug, isLegacy } = Astro.props;
const commits = getPostHistory(slug);
const head = getHeadCommit();

const latest = commits[0];
const added = commits[commits.length - 1];

function tagsFor(hash: string) {
  const tags = [];
  if (hash === added?.hash) tags.push('added');
  if (hash === latest?.hash) tags.push('latest');
  if (hash === head) tags.push('HEAD');
  return tags;
}
---

{commits.length > 0 && (
  <section class="post-history">
    <p class="meta-line">
      Added in <a href={added.url} target="_blank" rel="noopener"><code>{added.hash}</code></a>
      {latest.hash !== added.hash && (
        <>
          {' · Last changed in '}
          <a href={latest.url} target="_blank" rel="noopener"><code>{latest.hash}</code></a>
        </>
      )}
    </p>

    <details class="post-history-details">
      <summary>Commit history ({commits.length})</summary>

      {isLegacy && (
        <p class="notice panel">
          This history is inaccurate. These commits are from migrating the old site, not from when the post
          was written. The site before the rebuild is <a href={OLD_SITE_TREE_URL} target="_blank" rel="noopener">still in the repo</a>.
        </p>
      )}

      <ol class="post-history-list">
        {commits.map((commit) => (
          <li>
            <p class="post-history-when meta-line">
              <time datetime={commit.date.toISOString()}>{formatPostDate(commit.date)}</time>
              <span class="post-history-ago" data-ago={commit.date.toISOString()}></span>
            </p>
            <p class="post-history-what">
              <span class="post-history-subject">{commit.subject}</span>
              <a href={commit.url} target="_blank" rel="noopener"><code>{commit.hash}</code></a>
              <span class="post-history-diff">
                <span class="diff-added">+{commit.added}</span>
                <span class="diff-removed">−{commit.deleted}</span>
              </span>
              {tagsFor(commit.hash).map((tag) => <span class="post-history-tag">[{tag}]</span>)}
            </p>
          </li>
        ))}
      </ol>

      <p class="meta-line post-history-note">The +/− counts are for this post only.</p>
    </details>
  </section>
)}

<script is:inline type="module" src="/scripts/time-ago.js"></script>
