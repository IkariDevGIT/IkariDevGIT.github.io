---
import type { ResolvedGroup } from '../lib/resources';
import { RESOURCE_STATUS_LABEL } from '../lib/resources';
import { formatShortDate } from '../lib/dateFormat.mjs';

interface Props {
  group: ResolvedGroup;
  /** Heading level for this group's title; nested groups go one deeper. */
  level: 2 | 3 | 4 | 5 | 6;
}

const { group, level } = Astro.props;
const Heading = `h${level}`;
const nextLevel = Math.min(level + 1, 6) as Props['level'];
---

<section id={group.id}>
  <Heading>
    {group.title}
    <a class="heading-anchor" aria-label="Link to this section" href={`#${group.id}`}></a>
  </Heading>
  {group.intro && <p>{group.intro}</p>}
  {group.links && group.links.length > 0 && (
    <ul>
      {group.links.map((link) => (
        <li class:list={{ 'resource-inactive': Boolean(link.status) }}>
          <span class="resource-row">
            <span class="resource-main">
              {link.favorite && <><span class="resource-fav" title="Favourite">*</span>{' '}</>}
              <a href={link.href} target="_blank" rel={link.status ? 'noopener nofollow' : 'noopener'}>{link.label}</a>
              {link.note && <>{' '}<span class="resource-sep">~</span>{' '}<span class="resource-note">{link.note}</span></>}
            </span>
            {link.addedDate ? (
              <time class="resource-added" datetime={link.addedDate.toISOString()}>{formatShortDate(link.addedDate)}</time>
            ) : (
              <span class="resource-added">unknown</span>
            )}
          </span>
          {link.status && (
            <span class="resource-status">
              <span class="status-badge" data-status="inactive">{RESOURCE_STATUS_LABEL}</span>
              {' '}{link.status}
            </span>
          )}
        </li>
      ))}
    </ul>
  )}
  {group.groups && group.groups.map((subgroup) => <Astro.self group={subgroup} level={nextLevel} />)}
</section>
