---
import { getFeaturablePosts } from '../lib/posts';
import { postCardHtml } from '../lib/postCard.mjs';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;

const post = (await getFeaturablePosts()).find((candidate) => candidate.slug !== currentSlug);
---

{
  post && (
    <section class="recommended box2">
      <div class="box">
        <h2>Liked this post? Read this one too</h2>
        <ul
          class="post-list post-embed"
          set:html={postCardHtml({
            slug: post.slug,
            title: post.title,
            description: post.description,
            pubDate: post.pubDate,
            updatedDate: post.updatedDate,
            authors: post.authors,
            isEmbed: true,
          })}
        />
      </div>
    </section>
  )
}
